# ===================================================
# Website Style Planner - Environment Configuration
# ===================================================

PORT=5000
APP_URL=http://localhost:3000

# Optional MongoDB Connection for Persistent Cloud Storage
MONGODB_URI=

# Optional WhatsApp Cloud API Credentials (Meta Graph API)
# If left blank, the application operates in Mode A (client-side PDF generation & wa.me deep links)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
